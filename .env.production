# Mode-specific, so it wins over .env.local during `npm run build`.
#
# Without this file a local .env.local — the kind used to point the app at a
# backend on your own machine — silently won the production build and shipped a
# dashboard that called localhost. Vite's precedence is
# .env < .env.local < .env.production < .env.production.local, so pinning the
# real API here means a developer's local override can never reach a release.
VITE_API_URL=https://upgrbihy03.execute-api.us-east-2.amazonaws.com/api
VITE_WS_URL=wss://3vy3myrk36.execute-api.us-east-2.amazonaws.com/prod
VITE_ENABLE_DEMO_MODE=false
